# ==============================================================================
# FoodBridge Universal Redistribution Network — Environment Variables Template
# Copy this file to .env (or backend/.env) and populate with your credentials.
# NEVER commit .env files containing real secret keys to source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SYSTEM CONFIGURATION
# ------------------------------------------------------------------------------
APP_NAME="FoodBridge Universal Redistribution Network"
ENV=development                  # development | staging | production
PORT=8000                        # Backend ASGI port
DEBUG=true                       # Set to false in production

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & JWT SECURITY (REQUIRED)
# ------------------------------------------------------------------------------
# Generate a secure 64-character hex key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_cryptographically_secure_random_64_character_hex_secret_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# ------------------------------------------------------------------------------
# 3. DATABASE CONNECTION (SUPABASE / POSTGRESQL)
# ------------------------------------------------------------------------------
# Example: postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodbridge

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI (MULTIMODAL FRESHNESS & FOOD INSPECTION)
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
# If unset, the backend cleanly falls back to deterministic thermodynamic decay curves.
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 5. PERSISTENT STORAGE (BINARY EVIDENCE VAULT)
# ------------------------------------------------------------------------------
# Path where photos, videos, and evidence uploads are persisted on disk
UPLOADS_DIR=backend/uploads

# Optional: Cloudinary / Supabase Storage credentials if offloading disk storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 6. MAPS & LOCATION TELEMETRY
# ------------------------------------------------------------------------------
# FoodBridge uses OpenStreetMap / Leaflet with Haversine distance matrix by default.
# Optional: Mapbox or Azure Maps API key for specialized enterprise routing
MAPBOX_ACCESS_TOKEN=
AZURE_MAPS_KEY=

# ------------------------------------------------------------------------------
# 7. NOTIFICATIONS & WHATSAPP
# ------------------------------------------------------------------------------
# FoodBridge uses verified direct deep-links (wa.me) by default.
# Optional: Meta WhatsApp Cloud API credentials for automated background dispatch
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_CLOUD_API_TOKEN=

# ------------------------------------------------------------------------------
# 8. PAYMENT GATEWAY (B2B SAAS SUBSCRIPTIONS & CSR)
# ------------------------------------------------------------------------------
# Razorpay / Cashfree test keys. Operates in sandbox mode by default.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_hmac_secret

# ------------------------------------------------------------------------------
# 9. FRONTEND INTEGRATION
# ------------------------------------------------------------------------------
# Used by Vite client to communicate with FastAPI gateway
VITE_API_URL=http://localhost:8000
VITE_APP_NAME="FoodBridge"

